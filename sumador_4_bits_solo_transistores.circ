  <circuit name="Paso01_Transistor_N">
    <a name="circuit" val="Paso01_Transistor_N"/>
    <comp lib="8" loc="(120,50)" name="Text">
      <a name="text" val="LECCIÓN 1: el transistor N (NMOS) es un INTERRUPTOR que se cierra con 1"/>
      <a name="font" val="SansSerif bold 20"/>
      <a name="color" val="#1f4e9c"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(120,85)" name="Text">
      <a name="text" val='Tiene 3 patas:  G = compuerta (la "palanca")   D = drenaje   S = fuente.  La corriente pasa entre D y S sólo si G lo permite.'/>
      <a name="font" val="SansSerif plain 13"/>
      <a name="color" val="#000000"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="0" loc="(240,320)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="G"/>
    </comp>
    <comp lib="0" loc="(400,300)" name="Transistor">
      <a name="type" val="n"/>
      <a name="facing" val="north"/>
      <a name="selloc" val="bl"/>
    </comp>
    <comp lib="0" loc="(400,380)" name="Ground">
    </comp>
    <comp lib="0" loc="(600,240)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="Salida"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="8" loc="(415,285)" name="Text">
      <a name="text" val="D"/>
      <a name="font" val="SansSerif bold 13"/>
      <a name="color" val="#2050b0"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(415,350)" name="Text">
      <a name="text" val="S"/>
      <a name="font" val="SansSerif bold 13"/>
      <a name="color" val="#2050b0"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(300,305)" name="Text">
      <a name="text" val="G"/>
      <a name="font" val="SansSerif bold 13"/>
      <a name="color" val="#2050b0"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(415,400)" name="Text">
      <a name="text" val="tierra = GND = − = 0"/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="color" val="#505050"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(700,180)" name="Text">
      <a name="text" val="PRUEBA con la manito (Ctrl+1): haz clic en G."/>
      <a name="font" val="SansSerif bold 14"/>
      <a name="color" val="#206020"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(700,230)" name="Text">
      <a name="text" val="G = 1  -&gt;  el interruptor se CIERRA: la Salida queda unida a tierra  -&gt;  Salida = 0"/>
      <a name="font" val="SansSerif plain 13"/>
      <a name="color" val="#2050b0"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(700,260)" name="Text">
      <a name="text" val='G = 0  -&gt;  el interruptor se ABRE: la Salida no toca nada  -&gt;  queda "flotando"'/>
      <a name="font" val="SansSerif plain 13"/>
      <a name="color" val="#2050b0"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(700,290)" name="Text">
      <a name="text" val="              (Logisim lo muestra AZUL y con una U: no vale ni 0 ni 1, está desconectada)"/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="color" val="#505050"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(700,350)" name="Text">
      <a name="text" val="Regla para acordarte:  N = se activa con 1  y sirve para bajar la salida a 0 (a tierra)."/>
      <a name="font" val="SansSerif bold 14"/>
      <a name="color" val="#000000"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(700,420)" name="Text">
      <a name="text" val=" G | interruptor | Salida&#10; 0 |  abierto    | flotando&#10; 1 |  cerrado    |    0"/>
      <a name="font" val="Monospaced plain 14"/>
      <a name="color" val="#000000"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <wire from="(240,320)" to="(380,320)"/>
    <wire from="(400,340)" to="(400,380)"/>
    <wire from="(400,240)" to="(400,300)"/>
    <wire from="(400,240)" to="(600,240)"/>
  </circuit>
  <circuit name="Paso02_Transistor_P">
    <a name="circuit" val="Paso02_Transistor_P"/>
    <comp lib="8" loc="(120,50)" name="Text">
      <a name="text" val='LECCIÓN 2: el transistor P (PMOS) es el "opuesto": un interruptor que se cierra con 0'/>
      <a name="font" val="SansSerif bold 20"/>
      <a name="color" val="#1f4e9c"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(120,85)" name="Text">
      <a name="text" val='Fíjate en la BOLITA que tiene en la pata G: en electrónica una bolita significa "al revés" (se activa con 0).'/>
      <a name="font" val="SansSerif plain 13"/>
      <a name="color" val="#000000"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="0" loc="(400,220)" name="Power">
    </comp>
    <comp lib="0" loc="(400,300)" name="Transistor">
      <a name="type" val="p"/>
      <a name="facing" val="south"/>
      <a name="selloc" val="bl"/>
    </comp>
    <comp lib="0" loc="(240,280)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="G"/>
    </comp>
    <comp lib="0" loc="(600,360)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="Salida"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="8" loc="(415,205)" name="Text">
      <a name="text" val="+ = VDD = voltaje = 1"/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="color" val="#505050"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(415,255)" name="Text">
      <a name="text" val="S"/>
      <a name="font" val="SansSerif bold 13"/>
      <a name="color" val="#b03030"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(415,310)" name="Text">
      <a name="text" val="D"/>
      <a name="font" val="SansSerif bold 13"/>
      <a name="color" val="#b03030"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(300,265)" name="Text">
      <a name="text" val="G"/>
      <a name="font" val="SansSerif bold 13"/>
      <a name="color" val="#b03030"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(700,180)" name="Text">
      <a name="text" val="PRUEBA con la manito: haz clic en G."/>
      <a name="font" val="SansSerif bold 14"/>
      <a name="color" val="#206020"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(700,230)" name="Text">
      <a name="text" val="G = 0  -&gt;  el interruptor se CIERRA: la Salida queda unida al +  -&gt;  Salida = 1"/>
      <a name="font" val="SansSerif plain 13"/>
      <a name="color" val="#b03030"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(700,260)" name="Text">
      <a name="text" val="G = 1  -&gt;  el interruptor se ABRE: la Salida queda flotando (azul)"/>
      <a name="font" val="SansSerif plain 13"/>
      <a name="color" val="#b03030"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(700,330)" name="Text">
      <a name="text" val="Regla para acordarte:  P = se activa con 0  y sirve para subir la salida a 1 (al +)."/>
      <a name="font" val="SansSerif bold 14"/>
      <a name="color" val="#000000"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(700,360)" name="Text">
      <a name="text" val="Por eso en TODAS las compuertas los P van ARRIBA (pegados al +) y los N ABAJO (pegados a tierra)."/>
      <a name="font" val="SansSerif plain 13"/>
      <a name="color" val="#000000"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(700,430)" name="Text">
      <a name="text" val=" G | interruptor | Salida&#10; 0 |  cerrado    |    1&#10; 1 |  abierto    | flotando"/>
      <a name="font" val="Monospaced plain 14"/>
      <a name="color" val="#000000"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <wire from="(400,220)" to="(400,260)"/>
    <wire from="(240,280)" to="(380,280)"/>
    <wire from="(400,300)" to="(400,360)"/>
    <wire from="(400,360)" to="(600,360)"/>
  </circuit>
