    <comp lib="8" loc="(160,100)" name="Text">
      <a name="text" val="1 PMOS arriba y 1 NMOS abajo. Si A=1 el NMOS une Y con GND (Y=0); si A=0 el PMOS une Y con VDD (Y=1)."/>
      <a name="font" val="SansSerif plain 13"/>
      <a name="color" val="#000000"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
    <comp lib="8" loc="(160,130)" name="Text">
      <a name="text" val="Todo está hecho SOLO con transistores: arriba PMOS (conducen con 0), abajo NMOS (conducen con 1)."/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="color" val="#505050"/>
