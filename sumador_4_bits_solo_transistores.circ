    <comp lib="8" loc="(920,300)" name="Text">
      <a name="text" val=" A | Y&#10; 0 | 1&#10; 1 | 0"/>
      <a name="font" val="Monospaced plain 14"/>
      <a name="color" val="#000000"/>
      <a name="halign" val="left"/>
      <a name="valign" val="center"/>
    </comp>
